# Copy to .dev.vars for local development, then replace every placeholder.
# Never commit the resulting .dev.vars file.
AUTH_RATE_LIMIT_SECRET=replace-with-a-different-random-secret-at-least-32-characters
VAPID_PUBLIC_KEY=replace-with-the-public-key-from-npm-run-generate-vapid
TURNSTILE_SITE_KEY=replace-with-your-free-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-your-free-cloudflare-turnstile-secret-key
