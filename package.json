{
  "name": "kinguardian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check:release": "npm run build && node tools/verify-release.mjs",
    "predev": "npm run build",
    "dev": "node tools/dev.mjs",
    "dev:checkins": "wrangler dev --config worker/wrangler.toml",
    "generate:vapid": "node tools/generate-vapid-keys.mjs",
    "predeploy:pages": "npm run build",
    "deploy:pages": "wrangler pages deploy dist",
    "deploy:checkins": "wrangler deploy --config worker/wrangler.toml",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "libphonenumber-js": "1.13.15",
    "maplibre-gl": "6.16.0",
    "qr": "0.7.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.158.0"
  },
  "allowScripts": {
    "workerd@1.20261104.1": true,
    "esbuild": false
  }
}
